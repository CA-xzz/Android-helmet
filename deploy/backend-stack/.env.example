HELMET_BACKEND_IMAGE_TAG=development
HELMET_PUBLIC_HOST=helmet.example.com
HELMET_ACME_EMAIL=developer@example.com
HELMET_MQTT_PUBLIC_HOST=mqtt.example.com

HELMET_S3_ENDPOINT=https://s3.example.com
HELMET_S3_BUCKET=helmet-media
HELMET_S3_REGION=example-region-1
HELMET_S3_PREFIX=helmet-media
HELMET_S3_SSE=AES256

HELMET_STUN_URLS=stun:stun.example.com:3478
HELMET_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
HELMET_MAP_TILE_URL_TEMPLATE=https://tiles.example.com/{z}/{x}/{y}.png
HELMET_MAP_ATTRIBUTION=Map provider attribution
HELMET_MAP_MIN_ZOOM=3
HELMET_MAP_MAX_ZOOM=19

HELMET_AUTH_CONFIG_FILE=/controlled/helmet/secrets/helmet-auth.json
HELMET_POSTGRES_PASSWORD_FILE=/controlled/helmet/secrets/postgres-password
HELMET_S3_ACCESS_KEY_FILE=/controlled/helmet/secrets/s3-access-key
HELMET_S3_SECRET_KEY_FILE=/controlled/helmet/secrets/s3-secret-key
HELMET_TURN_SECRET_FILE=/controlled/helmet/secrets/turn-shared-secret
HELMET_MQTT_CA_FILE=/controlled/helmet/secrets/mqtt-ca.pem
HELMET_MQTT_CRL_FILE=/controlled/helmet/secrets/mqtt-crl.pem
HELMET_MQTT_SERVER_CERTIFICATE_FILE=/controlled/helmet/secrets/mqtt-server-cert.pem
HELMET_MQTT_SERVER_PRIVATE_KEY_FILE=/controlled/helmet/secrets/mqtt-server-key.pem
HELMET_MQTT_BACKEND_CERTIFICATE_FILE=/controlled/helmet/secrets/mqtt-backend-cert.pem
HELMET_MQTT_BACKEND_PRIVATE_KEY_FILE=/controlled/helmet/secrets/mqtt-backend-key.pem
